         private void WithTreeViewUpdate(Action action)
         {
             _TreeView.BeginUpdate();
             try
             {
                 action();
             }
             finally
             {
                 _TreeView.EndUpdate();
             }
         }
+
+        /// <summary>
+        /// Expands a node programmatically. By default this suppresses
+        /// <see cref="Tv1_BeforeExpand"/> async population behavior.
+        /// </summary>
+        private void ExpandProgrammatically(TreeNode node, bool suppressBeforeExpand = true)
+        {
+            ArgumentNullException.ThrowIfNull(node);
+
+            if (!suppressBeforeExpand)
+            {
+                node.Expand();
+                return;
+            }
+
+            _programmaticExpandSuppressionDepth++;
+            try
+            {
+                node.Expand();
+            }
+            finally
+            {
+                _programmaticExpandSuppressionDepth--;
+            }
+        }
